# PostgreSQL connection — consumed by the app, the postgres image, and the Makefile.
# REQUIRED: the server will refuse to start if DATABASE_URL is unset or empty.
# Production: point DATABASE_URL at the managed/prod cluster; rotate POSTGRES_* secrets.
DATABASE_URL=postgresql://user:password@db:5432/gv-db?sslmode=disable
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gv-db
# Name of the test database (Makefile composes TEST_DB_URL from this + POSTGRES_*)
TEST_DB=gv-db-tests

# HTTP server
PORT=8080
# IANA timezone for date arithmetic (defaults to Europe/Madrid in code if unset)
TIMEZONE=Europe/Madrid

# REQUIRED: the server will refuse to start if any of these are unset or empty.
# Login passwords (the app authenticates against these)
PASSWORD=Private123..
SEMIPRIVATE_PASSWORD=Semiprivate123..
# Random secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Base32 secret used for TOTP — generate with: openssl rand -base32 20
TOTP_SECRET=change-me
# REQUIRED: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Domotics lights ---
# Which bulbs exist is a table, managed from the Lights tab (scan, pick, name). These settings
# only say how to reach them.
#   mock   - in-memory, touches no hardware, invents a couple of bulbs to scan (default)
#   bluez  - drive real bulbs over this host's Bluetooth adapter
# The bluez driver needs the host's D-Bus socket mounted into the container; see
# docker-compose.yaml. Without it the API still runs and every bulb reads offline.
LIGHTS_DRIVER=mock
# LIGHTS_ADAPTER=hci0
# A cold connect measures ~11s when BlueZ has to rediscover the bulb, so don't drop this much
# below 20s.
# LIGHTS_CONNECT_TIMEOUT_MS=20000
# LIGHTS_CACHE_MS=2000
# These bulbs take one central at a time, so a link nobody is using is handed back to the
# bulb's own remote and the vendor app after this long.
# LIGHTS_IDLE_DISCONNECT_MS=90000
# These bulbs sometimes land a step off the value they were given, so a write is verified and
# re-applied until it holds. 0 attempts disables it.
# LIGHTS_SETTLE_ATTEMPTS=2
# LIGHTS_SETTLE_DELAY_MS=400
