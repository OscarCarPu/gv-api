DATABASE_URL=postgresql://user:password@db:5432/gv-db?sslmode=disable
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gv-db
TEST_DB=gv-db-tests

PORT=8080
TIMEZONE=Europe/Madrid
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
HEALTH_TIMEOUT_MS=2000

PASSWORD=Private123..
SEMIPRIVATE_PASSWORD=Semiprivate123..
# openssl rand -hex 32
JWT_SECRET=change-me
# openssl rand -base32 20
TOTP_SECRET=change-me

DAILY_CAPACITY_HOURS=14

# mock | bluez
LIGHTS_DRIVER=mock
LIGHTS_ADAPTER=hci0
LIGHTS_CONNECT_TIMEOUT_MS=60000
LIGHTS_IDLE_DISCONNECT_MS=90000
LIGHTS_CACHE_MS=2000
LIGHTS_POLL_MS=60000
LIGHTS_SETTLE_ATTEMPTS=2
LIGHTS_SETTLE_DELAY_MS=400

PIPELINE_DATABASE_URL=postgresql://user:password@host.docker.internal:54321/db?sslmode=disable
PIPELINE_STALE_AFTER_MS=7200000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/calendar/google/callback
# openssl rand -hex 32
GOOGLE_TOKEN_KEY=
CALENDAR_WEB_APP_URL=http://localhost:3000
CALENDAR_WEBHOOK_URL=
# Empty: enabled when CALENDAR_WEBHOOK_URL is set
CALENDAR_WEBHOOK_ENABLED=
CALENDAR_WATCH_TTL_MS=604800000
CALENDAR_WATCH_RENEW_BEFORE_MS=86400000
CALENDAR_SYNC_INTERVAL_MS=900000
CALENDAR_DEBOUNCE_MS=2000
# Backups, see docs/api/backups.md. Interval 0 disables the schedule
BACKUP_DIR=/backups
BACKUP_INTERVAL_MS=3600000
BACKUP_KEEP_HOURLY_DAYS=2
BACKUP_KEEP_DAILY_DAYS=30

# Off-site copy to S3; empty bucket = local only
BACKUP_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
