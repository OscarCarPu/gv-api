# PostgreSQL connection — consumed by the app, the postgres image, and the Makefile.
# REQUIRED: the server will refuse to start if DATABASE_URL is unset or empty.
# Production: point DATABASE_URL at the managed/prod cluster; rotate POSTGRES_* secrets.
DATABASE_URL=postgresql://user:password@db:5432/gv-db?sslmode=disable
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gv-db
# Name of the test database (Makefile composes TEST_DB_URL from this + POSTGRES_*)
TEST_DB=gv-db-tests

# HTTP server
PORT=8080
# IANA timezone for date arithmetic (defaults to Europe/Madrid in code if unset)
TIMEZONE=Europe/Madrid

# REQUIRED: the server will refuse to start if any of these are unset or empty.
# Login passwords (the app authenticates against these)
PASSWORD=Private123..
SEMIPRIVATE_PASSWORD=Semiprivate123..
# Random secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Base32 secret used for TOTP — generate with: openssl rand -base32 20
TOTP_SECRET=change-me
# REQUIRED: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Assistant ("Voz") ---
# Provider for the natural-language assistant: "gemini" (cheap), "anthropic", or "stub" (dev/no-key).
# The selected provider's API key below is REQUIRED (the server refuses to start without it).
ASSISTANT_PROVIDER=gemini
# Google Gemini key (get one free at https://aistudio.google.com/apikey).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model id. Leave blank to use the provider default:
#   gemini    -> gemini-3.1-flash-lite (cheap: $0.25/$1.50 per 1M)
#   anthropic -> claude-haiku-4-5
ASSISTANT_MODEL=
# HMAC secret used to sign suggestion tokens. Defaults to JWT_SECRET when empty.
ASSISTANT_SIGNING_SECRET=
# Read-query safety limits.
ASSISTANT_READ_TIMEOUT_MS=3000
ASSISTANT_MAX_ROWS=200
# Price table (USD per 1M tokens) for cost metering — overridable per field.
ASSISTANT_PRICE_GEMINI_INPUT=0.25
ASSISTANT_PRICE_GEMINI_OUTPUT=1.50
ASSISTANT_PRICE_GEMINI_CACHE_READ=0.06
ASSISTANT_PRICE_GEMINI_CACHE_WRITE=0.25
ASSISTANT_PRICE_HAIKU_INPUT=1.00
ASSISTANT_PRICE_HAIKU_OUTPUT=5.00
ASSISTANT_PRICE_HAIKU_CACHE_READ=0.10
ASSISTANT_PRICE_HAIKU_CACHE_WRITE=1.25
