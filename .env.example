# PostgreSQL connection — consumed by the app, the postgres image, and the Makefile.
# REQUIRED: the server will refuse to start if DATABASE_URL is unset or empty.
# Production: point DATABASE_URL at the managed/prod cluster; rotate POSTGRES_* secrets.
DATABASE_URL=postgresql://user:password@db:5432/gv-db?sslmode=disable
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gv-db
# Name of the test database (Makefile composes TEST_DB_URL from this + POSTGRES_*)
TEST_DB=gv-db-tests

# HTTP server
PORT=8080
# IANA timezone for date arithmetic (defaults to Europe/Madrid in code if unset)
TIMEZONE=Europe/Madrid

# REQUIRED: the server will refuse to start if any of these are unset or empty.
# Login passwords (the app authenticates against these)
PASSWORD=Private123..
SEMIPRIVATE_PASSWORD=Semiprivate123..
# Random secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Base32 secret used for TOTP — generate with: openssl rand -base32 20
TOTP_SECRET=change-me
# REQUIRED: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Domotics lights ---
# Which bulbs exist is a table, managed from the Lights tab (scan, pick, name). These settings
# only say how to reach them.
#   mock   - in-memory, touches no hardware, invents a couple of bulbs to scan (default)
#   bluez  - drive real bulbs over this host's Bluetooth adapter
# The bluez driver needs the host's D-Bus socket mounted into the container; see
# docker-compose.yaml. Without it the API still runs and every bulb reads offline.
LIGHTS_DRIVER=mock
# LIGHTS_ADAPTER=hci0
# A cold connect measures ~11s when BlueZ has to rediscover the bulb, so don't drop this much
# below 20s.
# LIGHTS_CONNECT_TIMEOUT_MS=20000
# LIGHTS_CACHE_MS=2000
# These bulbs take one central at a time, so a link nobody is using is handed back to the
# bulb's own remote and the vendor app after this long.
# LIGHTS_IDLE_DISCONNECT_MS=90000
# These bulbs sometimes land a step off the value they were given, so a write is verified and
# re-applied until it holds. 0 attempts disables it.
# LIGHTS_SETTLE_ATTEMPTS=2
# LIGHTS_SETTLE_DELAY_MS=400

# --- Calendar (Google) ---
# With no client id the calendar domain still mounts and answers: nothing is connected, nothing
# syncs, and the endpoints that need Google say so with a 503. The API boots either way.
#
# One-time setup in Google Cloud (see docs/business_logic/calendar.md):
#   - enable the Google Calendar API
#   - consent screen: External, and PUBLISHED to production. In "Testing" the refresh tokens
#     expire after 7 days and every account has to be reconnected weekly.
#   - scopes: .../auth/calendar and .../auth/userinfo.email
#   - a "Web application" client whose redirect URI matches GOOGLE_OAUTH_REDIRECT_URL exactly
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google requires HTTPS for redirect URIs except on localhost, so a LAN IP will not work.
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/calendar/google/callback
# REQUIRED once GOOGLE_CLIENT_ID is set: 32 bytes of hex encrypting the stored refresh tokens.
# Generate with: openssl rand -hex 32. Changing it makes the stored tokens unreadable.
# GOOGLE_TOKEN_KEY=
# Where the OAuth callback sends the browser back to. Defaults to the first ALLOWED_ORIGINS.
# CALENDAR_WEB_APP_URL=http://localhost:3000

# Push notifications: a public HTTPS address Google posts to when a calendar changes. This is
# what makes updates arrive in seconds instead of on the next poll. The domain also has to be
# verified in Search Console and registered with the Cloud project, or events.watch is refused.
# Unset means polling only.
# CALENDAR_WEBHOOK_URL=https://gv-api.lab-ocp.com/calendar/google/webhook
# CALENDAR_WEBHOOK_ENABLED defaults to true when a webhook url is set.
# CALENDAR_WEBHOOK_ENABLED=true
# Channels last about a week and cannot be renewed in place, so they are replaced this long
# before they expire.
# CALENDAR_WATCH_TTL_MS=604800000
# CALENDAR_WATCH_RENEW_BEFORE_MS=86400000
# The poll is the safety net behind the webhooks (google drops some, and channels can die
# quietly), not the main mechanism. 15 minutes with push, drop it if running without.
# CALENDAR_SYNC_INTERVAL_MS=900000
# One change in google produces a burst of notifications, so they are coalesced for a moment.
# CALENDAR_DEBOUNCE_MS=2000
