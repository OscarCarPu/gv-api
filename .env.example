# PostgreSQL connection — consumed by the app, the postgres image, and the Makefile.
# REQUIRED: the server will refuse to start if DATABASE_URL is unset or empty.
# Production: point DATABASE_URL at the managed/prod cluster; rotate POSTGRES_* secrets.
DATABASE_URL=postgresql://user:password@db:5432/gv-db?sslmode=disable
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=gv-db
# Name of the test database (Makefile composes TEST_DB_URL from this + POSTGRES_*)
TEST_DB=gv-db-tests

# HTTP server
PORT=8080
# IANA timezone for date arithmetic (defaults to Europe/Madrid in code if unset)
TIMEZONE=Europe/Madrid

# REQUIRED: the server will refuse to start if any of these are unset or empty.
# Login passwords (the app authenticates against these)
PASSWORD=Private123..
SEMIPRIVATE_PASSWORD=Semiprivate123..
# Random secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Base32 secret used for TOTP — generate with: openssl rand -base32 20
TOTP_SECRET=change-me
# REQUIRED: comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Domotics lights ---
# This server has no Bluetooth radio, so BLE runs in a bridge daemon
# (gv-web/scripts/ble-bridge/) on a LAN machine that does; the API talks to it over HTTP.
#   mock   - in-memory, touches no hardware (default)
#   bridge - drive real bulbs through the daemon
LIGHTS_DRIVER=mock
LIGHTS_BRIDGE_URL=http://192.168.1.160:8477
LIGHTS_BRIDGE_TOKEN=
# A cold BLE connect measures ~11s, so don't drop this much below 20s.
# LIGHTS_BRIDGE_TIMEOUT_MS=20000
# LIGHTS_CACHE_MS=2000
# These bulbs sometimes land a step off the value they were given, so a write is verified and
# re-applied until it holds. 0 attempts disables it.
# LIGHTS_SETTLE_ATTEMPTS=2
# LIGHTS_SETTLE_DELAY_MS=400

# Bulb registry. BLE addresses stay server-side; clients only ever see id/name/capabilities.
#   protocol       - a Protocol in gv-web/scripts/ble-bridge/protocols.py ('lexman', 'mock')
#   supportsColor  - false for tunable-white bulbs; hides the colour picker
LIGHTS=[{"id":"bedroom","name":"Bedroom","model":"LEXMAN ZBEK-13 CCT","address":"AA:BB:CC:DD:EE:FF","protocol":"lexman","supportsColor":false,"supportsColorTemp":true,"minColorTemp":2700,"maxColorTemp":6500}]
